{{- $pages := slice -}}

{{- range .Site.RegularPages -}}

    {{- if not .Params.excludeFromSearch -}}

        {{- $pages = $pages | append (dict
            "title" .Title
            "url" .RelPermalink
            "section" .Section
            "type" .Type
            "summary" (.Summary | plainify)
            "content" .Plain
            "tags" (.Params.tags | default (slice))
        ) -}}

    {{- end -}}

{{- end -}}

{{- $pages | jsonify -}}
